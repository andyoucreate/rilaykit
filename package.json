{
  "name": "@rilaykit/monorepo",
  "version": "1.0.0",
  "description": "A next-generation React form library with modularity, type safety, and extensibility at its core",
  "private": true,
  "author": "AND YOU CREATE <contact@andyoucreate.com>",
  "homepage": "https://rilay.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyoucreate/rilaykit.git"
  },
  "bugs": {
    "url": "https://github.com/andyoucreate/rilaykit/issues"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:ci": "pnpm build && vitest run",
    "test:ui": "vitest --ui",
    "type-check": "turbo run type-check",
    "clean": "turbo clean",
    "analyze": "node scripts/analyze-size.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "release": "pnpm build && pnpm changeset:publish",
    "release:beta": "pnpm build && pnpm changeset:publish --tag beta",
    "release:alpha": "pnpm build && pnpm changeset:publish --tag alpha",
    "version:patch": "changeset version && changeset tag",
    "version:minor": "changeset version && changeset tag",
    "version:major": "changeset version && changeset tag",
    "prerelease": "changeset pre enter",
    "prerelease:exit": "changeset pre exit",
    "version-packages": "changeset version",
    "analyze-size": "node scripts/analyze-size.js",
    "analyze-size:report": "node scripts/analyze-size.js --report",
    "size": "pnpm build && pnpm analyze-size",
    "benchmark": "node scripts/performance-benchmark.js",
    "benchmark:monitoring": "node scripts/performance-benchmark.js",
    "test:performance": "pnpm benchmark && pnpm test",
    "version-ci": "changeset version && biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.31.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "happy-dom": "^20.10.3",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.11",
      "minimatch": ">=10.2.3",
      "rollup": ">=4.59.0",
      "mdast-util-to-hast": ">=13.2.1",
      "vite": ">=7.3.2",
      "vitest": ">=3.2.6",
      "lodash": ">=4.18.1",
      "flatted": ">=3.4.2",
      "next": ">=16.1.7",
      "brace-expansion": ">=5.0.6",
      "picomatch": ">=2.3.2",
      "path-to-regexp": ">=8.4.0",
      "happy-dom": ">=20.8.9",
      "postcss": ">=8.5.10",
      "ws": ">=8.20.1",
      "turbo": ">=2.9.14",
      "react-router": ">=7.14.2",
      "esbuild": ">=0.28.1"
    }
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
