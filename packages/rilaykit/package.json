{
  "name": "rilaykit",
  "version": "0.2.0",
  "private": false,
  "description": "All-in-one package for RilayKit — headless forms and workflows for React",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk/index.d.mts",
        "default": "./dist/ai-sdk/index.mjs"
      },
      "require": {
        "types": "./dist/ai-sdk/index.d.ts",
        "default": "./dist/ai-sdk/index.js"
      }
    },
    "./anthropic": {
      "import": {
        "types": "./dist/anthropic/index.d.mts",
        "default": "./dist/anthropic/index.mjs"
      },
      "require": {
        "types": "./dist/anthropic/index.d.ts",
        "default": "./dist/anthropic/index.js"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["react", "forms", "workflows", "typescript", "validation", "builder-pattern"],
  "author": "AND YOU CREATE <contact@andyoucreate.com>",
  "license": "MIT",
  "homepage": "https://rilay.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyoucreate/rilaykit.git"
  },
  "bugs": {
    "url": "https://github.com/andyoucreate/rilaykit/issues"
  },
  "dependencies": {
    "@rilaykit/agent": "workspace:*",
    "@rilaykit/core": "workspace:*",
    "@rilaykit/forms": "workspace:*",
    "@rilaykit/workflow": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "ai": ">=5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "ai": "^5.0.0"
  },
  "typesVersions": {
    "*": {
      "react": ["./dist/react/index.d.ts"],
      "ai-sdk": ["./dist/ai-sdk/index.d.ts"],
      "anthropic": ["./dist/anthropic/index.d.ts"]
    }
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  }
}
