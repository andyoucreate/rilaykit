{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rilaykit/core": ["packages/core/src/index.ts"],
      "@rilaykit/forms": ["packages/forms/src/index.ts"],
      "@rilaykit/workflow": ["packages/workflow/src/index.ts"],
      "rilaykit": ["packages/rilaykit/src/index.ts"]
    }
  },
  "include": ["packages/**/tests/**/*.test-d.ts", "packages/**/tests/**/*.test-d.tsx"],
  "exclude": ["node_modules", "dist", "**/node_modules", "**/dist"]
}
